/* Solver-owned settings. Numeric bounds are inclusive.
 * SPDX-License-Identifier: BSD-2-Clause
 */
SS_STABLE(BOOL, pmg, mechanics_matrix_free, 0, 0, 1, "", "Apply high-order mechanics tangents without assembling the full matrix.")
SS_STABLE(BOOL, pmg, matrix_free_galerkin, 1, 0, 1, "", "Use Galerkin shell actions above P1 when mechanics is matrix-free.")
SS_STABLE(INT, pmg, matrix_free_block_nodes, 1, 1, 35, "", "Maximum entity nodes per matrix-free fine-level block.")
SS_STABLE(INT, pmg, matrix_free_batch_cells, 0, 0, 32, "", "Matrix-free fine-level action batch size. A value of 0 selects the order-specific kernel default.")
SS_STABLE(BOOL, pmg, fgmres_full_iterate_post, 0, 0, 1, "", "Apply post-FGMRES to the full iterate, starting from the coarse-corrected state.")
SS_STABLE(CHOICE, pmg, coarse_factorization, 0, 0, 1, "petsc_default|superlu_dist_reuse", "Configure the distributed SuperLU_DIST base factorization when selected.")
SS_STABLE(BOOL, pmg, coarse_lu_fallback_to_gamg, 0, 0, 1, "", "Use FGMRES/GAMG when distributed coarse LU is requested and the PETSc build lacks SuperLU_DIST.")
SS_STABLE(CHOICE, pmg, shared_point_balance, 0, 0, 2, "petsc|stable_hash_p2|stable_hash_high_order", "Choose how shared vertices, edges and high-order facets are owned after partitioning.")
SS_STABLE(INT, pmg, parmetis_seed, -1, -1, 2147483647, "", "Select ParMETIS with this seed. A value of -1 leaves PETSc partitioner selection in effect.")
SS_STABLE(CHOICE, linear, initial_guess, 0, 0, 2, "coarse_only|previous_complement|previous_complement_if_better", "Choose the mechanics FGMRES initial complementary correction.")
SS_STABLE(CHOICE, linear, orthogonalization, 0, 0, 3, "petsc|cgs_refine_always|cgs_unrefined|mgs", "Choose outer mechanics FGMRES orthogonalization and CGS refinement.")
SS_STABLE(BOOL, linear, use_mdot_gemv, 0, 0, 1, "", "Request PETSc's GEMV implementation of batched vector dot products.")
SS_STABLE(BOOL, nonlinear, allow_relaxed, 0, 0, 1, "", "Allow explicitly labelled relaxed Newton acceptance.")
SS_STABLE(INT, nonlinear, maximum_line_search_trials, 24, 1, 64, "", "Line-search trial budget per Newton correction. Directional search allows up to 62 and also evaluates two endpoints.")
SS_STABLE(CHOICE, nonlinear, fixed_line_search, 0, 0, 1, "directional|residual_monotone", "Choose the line search for fixed-factor mechanics Newton solves.")
SS_STABLE(BOOL, nonlinear, indirect_legacy_alg5_line_search, 0, 0, 1, "", "Use the reference directional ALG5 line search during indirect SSR.")
SS_STABLE(CHOICE, nonlinear, indirect_sensitivity, 0, 0, 1, "reference_forward|stable_central", "Choose the finite-difference sensitivity in work-controlled SSR.")
SS_STABLE(REAL, nonlinear, indirect_sensitivity_step, 0, 0, 0.1, "", "Relative central-difference step. A value of 0 selects the cube root of machine epsilon.")
SS_STABLE(CHOICE, nonlinear, indirect_progress_guard, 0, 0, 3, "off|fixed|adaptive|observe", "Disable, enforce, learn, or observe the indirect Newton progress guard.")
SS_STABLE(INT, nonlinear, indirect_progress_guard_iteration, 4, 0, 255, "", "Zero-based Newton correction at which an enabled progress guard samples.")
SS_STABLE(REAL, nonlinear, indirect_progress_guard_maximum, 0, 0, 1.7976931348623157e308, "", "Positive relative residual ceiling for the fixed progress guard.")
SS_STABLE(BOOL, nonlinear, indirect_adaptive_linear_tolerance, 0, 0, 1, "", "Tighten subsequent indirect linear solves when Newton damping triggers the forcing policy.")
SS_STABLE(INT, nonlinear, indirect_adaptive_linear_iteration_threshold, 2, 0, 2147483647, "", "Maximum previous inner iteration count that permits tolerance tightening.")
SS_STABLE(REAL, nonlinear, indirect_adaptive_linear_alpha_threshold, 0.1, 2.2250738585072014e-308, 1, "", "Line-search alpha below which the adaptive linear tolerance may tighten.")
SS_STABLE(REAL, nonlinear, indirect_adaptive_linear_tightening_factor, 0.5, 2.2250738585072014e-308, 0.9999999999999999, "", "Multiplier for tightening a linear relative tolerance.")
SS_STABLE(REAL, nonlinear, indirect_adaptive_linear_minimum_relative_tolerance, 0.0001, 2.2250738585072014e-308, 1, "", "Floor for the indirect adaptive linear relative tolerance.")
SS_STABLE(INT, continuation, consecutive_retry_limit, 5, 1, 5, "", "Maximum consecutive rejected attempts before continuation stops.")
SS_STABLE(CHOICE, continuation, work_step_controller, 0, 0, 2, "classic|predictor_error|work_efficiency", "Select the indirect work-step growth and retry controller.")
SS_STABLE(INT, continuation, work_growth_iteration_limit, 0, 0, 2147483647, "", "Newton effort gate. A value of 0 leaves classic unrestricted and derives five sixths of the Newton limit for adaptive modes.")
SS_STABLE(REAL, continuation, work_predictor_error_target, 1, 2.2250738585072014e-308, 1.7976931348623157e308, "", "Dimensionless predictor error target for adaptive work stepping.")
SS_STABLE(REAL, continuation, work_step_scale_minimum, 0.5, 2.2250738585072014e-308, 1, "", "Lower multiplicative bound on adaptive work-step updates.")
SS_STABLE(REAL, continuation, work_step_scale_maximum, 2, 1, 1.7976931348623157e308, "", "Upper multiplicative bound on adaptive work-step updates.")
SS_STABLE(INT, resources, operator_workspace_mib, 1024, 1, 2147483647, "", "Rank-local mechanics operator workspace cap in MiB.")
SS_STABLE(INT, resources, mechanics_pmg_memory_cap_mib, 2048, 1, 2147483647, "", "Aggregate mechanics PMG storage cap in MiB.")
SS_STABLE(INT, resources, hydraulic_pmg_memory_cap_mib, 2048, 1, 2147483647, "", "Aggregate seepage PMG storage cap in MiB.")
SS_STABLE(INT, resources, linear_vector_memory_cap_mib, 1024, 1, 2147483647, "", "Aggregate Krylov and deflation vector cap in MiB for either field.")
SS_STABLE(INT, outputs, krylov_history_limit, 0, 0, 1000000, "", "Maximum detailed Krylov residual rows per run. A value of 0 disables the detail.")
SS_STABLE(INT, outputs, pmg_apply_history_limit, 0, 0, 1000000, "", "Maximum detailed PMG application rows per run. A value of 0 disables the detail.")
SS_STABLE(BOOL, validation, qualification_mode, 0, 0, 1, "", "Use fixed-order assembly and operator actions for mechanics and its PMG levels.")
SS_EXPERT(BOOL, memory_view, "-native_memory_view", 0, 0, 1, "", "Print rank-local resident and allocator memory snapshots at graph phases.")
SS_EXPERT(INT, test_signal_after_accepted, "-native_test_signal_after_accepted", 0, 0, 2147483647, "", "Test-only signal injection on rank zero after this accepted-state count. A value of 0 disables it.")
