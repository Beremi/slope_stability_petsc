{
  "$id": "https://schemas.slope-stability.invalid/v1/case.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "type": "object"
    },
    "asset": {
      "type": "object"
    },
    "boundary_rules": {
      "type": "array"
    },
    "case_overrides": {
      "type": "object"
    },
    "created_by": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "tool",
        "tool_version",
        "source_id"
      ],
      "type": "object"
    },
    "discretization": {
      "additionalProperties": false,
      "properties": {
        "coordinate_order": {
          "enum": [
            1,
            2,
            4
          ]
        },
        "field_order": {
          "enum": [
            1,
            2,
            4,
            8
          ]
        },
        "volume_quadrature": {
          "enum": [
            "default",
            "paired_higher"
          ]
        }
      },
      "required": [
        "field_order",
        "coordinate_order"
      ],
      "type": "object"
    },
    "extensions": {
      "propertyNames": {
        "pattern": "^(org|com|net|io)\\.[a-z0-9.-]+$"
      },
      "type": "object"
    },
    "id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "identity": {
      "type": "object"
    },
    "kind": {
      "const": "slope_stability.case"
    },
    "materials": {
      "minItems": 1,
      "type": "array"
    },
    "physics": {
      "type": "object"
    },
    "prescribed_saturation": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "enum": [
            "x",
            "z"
          ]
        },
        "coordinates": {
          "items": {
            "type": "number"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "length_unit": {
          "minLength": 1,
          "type": "string"
        },
        "levels": {
          "items": {
            "type": "number"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "axis",
        "coordinates",
        "levels",
        "length_unit"
      ],
      "type": "object"
    },
    "profiles": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "required_outputs": {
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "additionalProperties": false,
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "minimum": 0,
          "type": "integer"
        },
        "patch": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor",
        "patch"
      ],
      "type": "object"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "created_by",
    "provenance",
    "extensions",
    "identity",
    "asset",
    "discretization",
    "materials",
    "physics",
    "boundary_rules",
    "analysis",
    "profiles",
    "case_overrides",
    "required_outputs"
  ],
  "title": "slope_stability.case",
  "type": "object"
}
